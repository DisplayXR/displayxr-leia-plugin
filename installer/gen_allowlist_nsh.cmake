#
# Generates Allowlist.nsh for DisplayXRLeiaSRInstaller.nsi: the ADR-054 N4b
# provenance-allowlist rows for the DLLs this installer ships that the RUNTIME
# loads (the DP plug-in and, when built, the conversion provider).
#
# Adapted from displayxr-runtime/installer/gen_allowlist_nsh.cmake; the row
# format (value name = SHA-256 hex, data = "<file> (<who> <version>)" under
# HKLM\Software\DisplayXR\Trust\Allowlist) is the runtime's, unchanged. The
# runtime's gate enforces by default: a plug-in DLL loads only if it is
# Authenticode-signed or its digest is listed, so an unsigned build (CI, a dev
# installer, a release the signing runner missed) would otherwise install a
# plug-in the runtime refuses. Digests are taken from the exact bytes packed.
#
# NOT listed: SimulatedRealityVulkan*.dll (the plug-in loads those, not the
# runtime) and NeurD's files (NeurD's own installer; the plug-in loads them).
#
#   cmake -DBIN_DIR=<_package/bin> -DVERSION=<x.y.z> -DOUT=<Allowlist.nsh>
#         [-DSHIP_CONV=1] -P gen_allowlist_nsh.cmake

if(NOT DEFINED BIN_DIR OR NOT DEFINED OUT)
	message(FATAL_ERROR "gen_allowlist_nsh.cmake: BIN_DIR and OUT are required")
endif()
if(NOT DEFINED VERSION)
	set(VERSION "dev")
endif()

# Keep in sync with the runtime-loaded `File "${BIN_DIR}\plugins\..."` lines of
# the .nsi.
set(_shipped_plugins "${BIN_DIR}/plugins/DisplayXR-LeiaSR.dll")
if(SHIP_CONV)
	list(APPEND _shipped_plugins "${BIN_DIR}/plugins/DisplayXR-LeiaConversion.dll")
endif()

set(_write "")
set(_remove "")
foreach(_dll IN LISTS _shipped_plugins)
	if(NOT EXISTS "${_dll}")
		message(FATAL_ERROR "gen_allowlist_nsh.cmake: shipped plug-in missing: ${_dll}")
	endif()
	file(SHA256 "${_dll}" _hex)
	get_filename_component(_name "${_dll}" NAME)
	string(APPEND _write
		"\tWriteRegStr HKLM \"Software\\DisplayXR\\Trust\\Allowlist\" \"${_hex}\" \"${_name} (DisplayXR Leia plug-in installer ${VERSION})\"\n")
	string(APPEND _remove
		"\tDeleteRegValue HKLM \"Software\\DisplayXR\\Trust\\Allowlist\" \"${_hex}\"\n")
	message(STATUS "allowlist: ${_name} sha256=${_hex}")
endforeach()

file(WRITE "${OUT}"
	"; Auto-generated by installer/gen_allowlist_nsh.cmake - do not edit.\n"
	"; ADR-054 N4b provenance allowlist rows for the runtime-loaded DLLs this installer ships.\n"
	"!macro DXR_ALLOWLIST_WRITE\n"
	"${_write}"
	"!macroend\n"
	"!macro DXR_ALLOWLIST_REMOVE\n"
	"${_remove}"
	"\tDeleteRegKey /ifempty HKLM \"Software\\DisplayXR\\Trust\\Allowlist\"\n"
	"\tDeleteRegKey /ifempty HKLM \"Software\\DisplayXR\\Trust\"\n"
	"!macroend\n")
