// Configured by CMake for each fake conversion module (tests only).
#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @FAKE_MAJOR@,@FAKE_MINOR@,@FAKE_PATCH@,0
 PRODUCTVERSION @FAKE_MAJOR@,@FAKE_MINOR@,@FAKE_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Fake conversion module (tests)"
            VALUE "FileVersion", "@FAKE_MAJOR@.@FAKE_MINOR@.@FAKE_PATCH@"
            VALUE "ProductName", "@FAKE_PRODUCT@"
            VALUE "ProductVersion", "@FAKE_MAJOR@.@FAKE_MINOR@.@FAKE_PATCH@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
